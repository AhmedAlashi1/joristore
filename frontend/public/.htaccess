# React Router (SPA) on Apache / cPanel — avoid 404 on refresh
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laravel API on store domain (~/joristore/public) — no dashboard SSL required
  RewriteCond %{REQUEST_URI} ^/index\.php/api [NC]
  RewriteRule ^index\.php/api(/.*)?$ api-laravel.php [L,QSA]

  RewriteCond %{REQUEST_URI} ^/index\.php/storage [NC]
  RewriteRule ^index\.php/storage(/.*)?$ api-laravel.php [L,QSA]

  # Static file: ~/public_html/storage → symlink, or direct path under joristore/public/storage
  RewriteCond %{REQUEST_URI} ^/storage/(.+)$
  RewriteCond %{DOCUMENT_ROOT}/../joristore/public/storage/%1 -f
  RewriteRule ^storage/(.+)$ %{DOCUMENT_ROOT}/../joristore/public/storage/$1 [L]

  # LiteSpeed: plain /storage often still hits SPA — internal route that works in production
  RewriteCond %{REQUEST_URI} ^/storage/
  RewriteRule ^storage/(.*)$ index.php/storage/$1 [L,QSA]

  # Serve existing files and directories as-is (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA routes only (not storage — must not return index.html)
  RewriteCond %{REQUEST_URI} !^/storage/
  RewriteCond %{REQUEST_URI} !^/index\.php/storage/
  RewriteRule ^ index.html [L]
</IfModule>

DirectoryIndex index.html
