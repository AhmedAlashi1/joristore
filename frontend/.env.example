# Local API (same origin when using Vite proxy — leave /api for dev)
VITE_API_BASE_URL=/api
VITE_STORE_SLUG=jori-store
# Full backend origin for uploaded images in dev
VITE_API_ORIGIN=http://127.0.0.1:8000

# Production (single domain example):
# VITE_API_BASE_URL=/api
# VITE_STORE_SLUG=jori-store
# VITE_API_ORIGIN=
